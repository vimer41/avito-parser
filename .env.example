# Токен вашего Telegram бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Интервал проверки каждого поиска в секундах (по умолчанию 60 сек)
CHECK_INTERVAL=60

# Максимальное количество активных поисков на одного пользователя
MAX_SEARCHES_PER_USER=10

# Прокси (необязательно, формат: http://user:pass@ip:port или socks5://user:pass@ip:port)
# Если запускаете на VPS без банов, оставьте пустым
PROXY_URL=
