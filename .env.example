# Токен вашего Telegram бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram ID администратора (кто одобряет доступ пользователям)
ADMIN_ID=986832959

# Базовый целевой интервал опроса нормализованных URL (15-20 сек для всех тарифов)
CHECK_INTERVAL=15
SCAN_TARGET_MIN_INTERVAL=15
SCAN_TARGET_MAX_INTERVAL=20

# Лимит радаров администратора (триал: 1, Standart: 4, PRO: 9)
MAX_SEARCHES_PER_USER=20

# Воркеры сканирования (по умолчанию 4, масштабируются до min(SCAN_MAX_WORKERS, max(4, healthy_proxies * 2)))
MAX_CONCURRENT_WORKERS=4
SCAN_MAX_WORKERS=32
SCAN_PROXY_ATTEMPTS=3
CHALLENGE_SOLVER_WORKERS=1

# Тарифная задержка доставки после обнаружения (в секундах):
# PRO / Admin = 0.0 с, Standart = 1.0 с, base / триал = 1.5 с
DELIVERY_DELAY_PRO_SECONDS=0.0
DELIVERY_DELAY_STANDART_SECONDS=1.0
DELIVERY_DELAY_BASE_SECONDS=1.5

# Telegram Outbox & Rate Limits
DELIVERY_WORKERS=8
TELEGRAM_GLOBAL_RATE_LIMIT=25.0
TELEGRAM_PER_CHAT_RATE_LIMIT=1.0
OUTBOX_MAX_AGE_SECONDS=1800

# Догон пропущенных лотов после подтвержденного простоя (только PRO / Admin)
CATCHUP_MAX_AGE_MINUTES=30
CATCHUP_MAX_ITEMS=10
CATCHUP_MAX_PAGES=3

# Пул статических прокси и сетевой бюджет:
# PROXY_POOL_FILE — путь к файлу со списком прокси (по одному на строку, комментарии через #).
# Если файл пуст или не найден, используется резервный одиночный прокси из PROXY_URL.
PROXY_POOL_FILE=proxies.txt
PROXY_URL=
PROXY_RATE_LIMIT=1.0
PROXY_MIN_RATE_LIMIT=0.25
PROXY_MAX_IN_FLIGHT=1
PROXY_BLOCK_COOLDOWN=180
PROXY_MAX_BLOCK_COOLDOWN=900

# Совместимые параметры одиночного бюджета и сбора каталога
AVITO_REQUESTS_PER_SECOND=0.5
AVITO_MAX_IN_FLIGHT=2
AVITO_BLOCK_BASE_COOLDOWN=30
AVITO_BLOCK_MAX_COOLDOWN=900
AVITO_FETCH_TIMEOUT=45
AVITO_MAX_REQUESTS_PER_FETCH=8
AVITO_MAX_PAGES_PER_SCAN=2

# Адаптивные целевые интервалы и защита от вечного бэклога
SCAN_MAX_INTERVAL=120
SCAN_BUDGET_UTILIZATION=0.8
SCAN_HYSTERESIS_WINDOWS=3
SCAN_MAX_RETRIES=2
SCAN_RETRY_BASE_DELAY=5
SCAN_RETRY_MAX_DELAY=60
SCAN_STARTUP_SPREAD=15
INITIAL_SNAPSHOT_TTL=25

# Пул чтения SQLite
DB_READ_POOL_SIZE=2

# Разовая подписка на 30 дней, без автопродления. Только Telegram Stars (XTR).
# Платежи выключены по умолчанию. Для включения после проверки укажите 1.
# Provider token, банковские реквизиты и криптовалюты не используются.
STARS_PAYMENTS_ENABLED=0
STARS_PRICE_STANDART=170
STARS_PRICE_PRO=470
